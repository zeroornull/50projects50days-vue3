{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["types/auto-imports.d.ts", "types/components.d.ts"],
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "sortImports": true,
  "sortPackageJson": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
