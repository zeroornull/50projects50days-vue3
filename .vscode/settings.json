{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "tsconfig.json": "tsconfig.*.json, env.d.ts, typed-router.d.ts",
    "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*",
    "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, commitlint.config.*, .oxlint*, oxlint*, .oxfmt*, oxfmt*, .editorconfig, bun.lock"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": false,
  // 保存时先由 Oxfmt 格式化，再应用 Oxlint 的安全修复。
  "editor.codeActionsOnSave": {
    "source.format.oxc": "always",
    "source.fixAll.oxc": "always"
  },
  "oxc.enable.oxfmt": true,
  "oxc.enable.oxlint": true,
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "oxc.requireConfig": true
}
