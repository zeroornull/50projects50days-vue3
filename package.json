{
  "name": "50projects-vue3",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-p lint:oxlint lint:eslint",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "format:check": "eslint .",
    "check": "run-p lint:oxlint lint:eslint type-check",
    "commitlint": "commitlint --edit",
    "deps:check": "taze major -r --exclude typescript@7",
    "deps:check:json": "taze major -r --exclude typescript@7 --json"
  },
  "dependencies": {
    "@types/mockjs": "^1.0.10",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "mockjs": "1.1.0",
    "vue": "3.6.0-rc.2",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-oxlint": "^1.77.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sass-embedded": "^1.100.0",
    "taze": "^20.0.0",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.9"
  }
}
